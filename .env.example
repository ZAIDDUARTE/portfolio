# Public integration URLs — safe to commit as placeholders.
# Copy to `.env.local` and replace with your real values before deploying.

NEXT_PUBLIC_BOOKING_URL=https://cal.com/USERNAME/20min
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/PHONENUMBER
# Formspree (or compatible) — enables real /connect project-inquiry delivery.
# Until set, the form shows an honest error and keeps mailto fallback (no false success).
NEXT_PUBLIC_FEEDBACK_FORM_ENDPOINT=https://formspree.io/f/FORM_ID
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/~015dcfc95d6b6b8758
